# ════════════════════════════════════════════════════════════
#  SAGE — Environment Variables Template
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env file — it is gitignored.
# ════════════════════════════════════════════════════════════

# ─── Claude / Anthropic (REQUIRED) ──────────────────────────
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Embeddings for RAG (REQUIRED for Phase 2) ──────────────
# Used to turn documents into vectors for semantic search.
# Get your key from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ─── Authentication ─────────────────────────────────────────
# A long random string used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ───────────────────────────────────────────────
# SQLite for local development (no server needed).
DATABASE_URL=sqlite+aiosqlite:///./data/sage.db

# ─── Storage Paths ──────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./uploads

# ─── Claude Model ───────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6

# ─── CORS (frontend origin) ─────────────────────────────────
CORS_ORIGINS=http://localhost:8501

# Set true to run signup/login without loading AI and RAG dependencies.
AUTH_ONLY_MODE=false
